# Google AI Studio API Key (used by Firebase Cloud Function for Gemini 3.x Flash)
# In production, set via Firebase Secrets:
# firebase functions:secrets:set GEMINI_API_KEY
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Preferred Gemini Model (defaults to gemini-3-flash with gemini-2.5-flash fallback)
GEMINI_MODEL=gemini-3-flash

# Optional: Local API endpoint rewrite override for Vite dev proxy
VITE_API_URL=http://127.0.0.1:5001/alt-text-generator-app/us-central1
